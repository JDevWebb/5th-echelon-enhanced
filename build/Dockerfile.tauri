# x86_64 WebKitGTK (and what it links to) unpacked into /sysroot, for building the Tauri launcher
# for Linux and the Steam Deck from this ARM image; the packages' build tools (Python, GObject
# introspection) are left out, as nothing here runs them.
FROM fes-build:local
RUN dpkg --add-architecture amd64 && apt-get update \
 && mkdir -p /tmp/debs /sysroot && cd /tmp/debs \
 && apt-cache depends --recurse --no-recommends --no-suggests --no-conflicts --no-breaks --no-replaces --no-enhances --no-pre-depends \
      libwebkit2gtk-4.1-dev:amd64 libssl-dev:amd64 libxdo-dev:amd64 librsvg2-dev:amd64 \
    | grep -E '^[a-z0-9][^ <>]*$' | sort -u \
    | grep -vE '^(libc6|libc6-dev|linux-libc-dev|libcrypt-dev|libcrypt1|libgcc-s1|libstdc\+\+6|python3|gobject-introspection|perl|dpkg|debconf|libc-dev-bin|gcc|cpp|binutils|bash|coreutils|dash|sed|grep|tar|init-system-helpers|sensible-utils|util-linux|mount|systemd|udev|adduser|passwd|login|base-files|lsb-base|install-info|ucf)[^ ]*(:amd64)?$' \
    > want.txt \
 && xargs -a want.txt apt-get download 2>/dev/null || true \
 && for d in *.deb; do dpkg-deb -x "$d" /sysroot; done \
 && find /sysroot -type l | while read -r l; do t=$(readlink "$l"); case "$t" in /*) ln -sfn "/sysroot$t" "$l";; esac; done \
 && rm -rf /tmp/debs /var/lib/apt/lists/* \
 && ls /sysroot/usr/lib/x86_64-linux-gnu/pkgconfig | wc -l
ENV PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_SYSROOT_DIR=/sysroot \
    PKG_CONFIG_LIBDIR=/sysroot/usr/lib/x86_64-linux-gnu/pkgconfig:/sysroot/usr/share/pkgconfig

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "5th Echelon Enhanced (Tauri trial)",
  "version": "0.0.1",
  "identifier": "net.jdevwebb.fifth-echelon.tauri-trial",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "5th Echelon Enhanced (Tauri trial)",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}

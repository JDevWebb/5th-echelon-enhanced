// The launcher's pages as rows (ui.rs and pages.rs build them): a card's title, a line of text,
// a switch, a choice, a slider, a text field, buttons, an item in a list (a friend, a server, a
// report), a test's result. One component draws any row, so every page that's a set of settings
// or a list (Settings, Friends, Servers, Host, Intel, Support, the setup, the dialogs) looks and
// works the same, by mouse, keyboard and controller.

import { ScrollView, AboutSlint } from "std-widgets.slint";
import { Theme, Type, Layout } from "theme.slint";
import { Btn, Link, Spinner, Dot, Caps, Rule, CheckBox, Segment, Choice, Field, Slide } from "widgets.slint";
import { EchelonMark } from "brand.slint";

export struct RowButton {
    id: string,
    label: string,
    // "primary", "ghost", "plain", "danger", "fix" (a text button) or "link".
    kind: string,
    enabled: bool,
}

export struct Row {
    // "title" (a card's title), "text", "note", "switch", "choice", "segments", "slider",
    // "field", "area" (several lines), "buttons", "item", "result", "code", "working", "rule",
    // "message" (a chat line), "mark" (the brand's mark and a heading, for empty pages), and
    // About's "caps" (a small heading), "about" (its head), "person", "support" and its
    // smaller "support-strip".
    kind: string,
    id: string,
    label: string,
    text: string,
    sub: string,
    // "muted", "warn", "bad", "accent", "ok", "fail" or "".
    tone: string,
    on: bool,
    enabled: bool,
    options: [string],
    current: int,
    value: float,
    min: float,
    max: float,
    placeholder: string,
    secret: bool,
    buttons: [RowButton],
    // Its place in its card: 0 not in one, 1 the first, 2 inside, 3 the last, 4 the only row.
    edge: int,
}

// A cup with a heart in it, in the accent: supporting the community servers.
component Cup inherits Rectangle {
    in property <length> size: 22px;
    width: size;
    height: size;
    accessible-role: none;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M4 8h12v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z M16 9h1.5a2.5 2.5 0 0 1 0 5H16";
        stroke: Theme.accent;
        stroke-width: 1.8px;
        fill: transparent;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M10 11.2c-.7-.9-2.2-.5-2.2.6 0 1.2 2.2 2.4 2.2 2.4s2.2-1.2 2.2-2.4c0-1.1-1.5-1.5-2.2-.6z";
        fill: Theme.accent;
    }
}

// One row. Its card's background, edge and corners are drawn by the row itself (first, inside,
// last), so a page is one flat list.
export component RowItem inherits Rectangle {
    in property <Row> item;
    callback toggled(string, bool);
    callback chosen(string, int);
    callback slid(string, float);
    callback edited(string, string);
    callback accepted(string, string);
    callback pressed(string);

    // The guided setup: text outside cards centred.
    in property <bool> centre-text;
    property <bool> carded: item.edge > 0;
    property <bool> centre: centre-text && !carded;
    property <bool> top: item.edge == 1 || item.edge == 4;
    property <bool> bottom: item.edge == 3 || item.edge == 4;
    property <length> pad-x: carded ? 20px : 0px;
    property <color> tone-colour: item.tone == "warn" ? Theme.warn
        : item.tone == "bad" || item.tone == "fail" ? Theme.bad
        : item.tone == "accent" || item.tone == "ok" ? Theme.accent
        : item.tone == "muted" ? Theme.muted
        : Theme.fg;

    min-height: lay.preferred-height;

    // The card round it.
    if carded: Rectangle {
        y: top ? 0px : -2px;
        height: parent.height + (top ? 0px : 2px) + (bottom ? 0px : 2px);
        background: Theme.surface;
        border-radius: 0;
        Rectangle { x: 0; width: 1px; background: Theme.line; }
        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
        if top: Rectangle { y: 0; height: 1px; background: Theme.line; }
        if bottom: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    }

    lay := VerticalLayout {
        padding-left: pad-x;
        padding-right: pad-x;
        padding-top: top ? 18px : (carded ? 5px : 4px);
        padding-bottom: bottom ? 18px : (carded ? 5px : 4px);

        if item.kind == "title": Text {
            text: item.label;
            font-family: Type.cond;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: 0.6px;
            color: Theme.fg;
            accessible-role: text;
        }
        if item.kind == "text": Text {
            text: item.text;
            wrap: word-wrap;
            horizontal-alignment: centre ? center : left;
            color: item.tone == "" ? Theme.fg : tone-colour;
            font-weight: item.on ? 600 : 400;
        }
        if item.kind == "note": Text {
            text: item.text;
            wrap: word-wrap;
            horizontal-alignment: centre ? center : left;
            font-size: Type.small;
            color: item.tone == "" ? Theme.soft : tone-colour;
        }
        if item.kind == "code": HorizontalLayout {
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: Theme.sunken;
                height: ct.preferred-height + 12px;
                ct := Text { x: 8px; width: parent.width - 16px; text: item.text; wrap: word-wrap; font-family: Type.mono; font-size: 12.5px; color: Theme.fg; }
            }
            for b in item.buttons: Btn { text: b.label; small: true; enabled: b.enabled; kind: b.kind; clicked => { root.pressed(b.id); } }
        }
        if item.kind == "switch": sw := Rectangle {
            height: max(36px, sl.preferred-height + 8px);
            accessible-role: switch;
            accessible-label: item.label;
            accessible-description: item.sub;
            accessible-checked: item.on;
            accessible-enabled: item.enabled;
            accessible-action-default => { if item.enabled { root.toggled(item.id, !item.on); } }
            forward-focus: swf;
            swf := FocusScope {
                enabled: item.enabled;
                key-pressed(e) => {
                    if item.enabled && (e.text == " " || e.text == Key.Return) { root.toggled(item.id, !item.on); return accept; }
                    reject
                }
            }
            sta := TouchArea {
                enabled: item.enabled;
                mouse-cursor: item.enabled ? pointer : default;
                clicked => { root.toggled(item.id, !item.on); }
            }
            sl := HorizontalLayout {
                spacing: 12px;
                opacity: item.enabled ? 1 : 0.5;
                Rectangle {
                    width: 38px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 11px;
                    background: item.on ? Theme.accent : Theme.control;
                    border-width: item.on ? 0px : 1px;
                    border-color: Theme.control-line;
                    animate background { duration: Theme.quick; }
                    Rectangle {
                        x: item.on ? parent.width - self.width - 3px : 3px;
                        y: 3px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: item.on ? Theme.on-accent : Theme.soft;
                        animate x { duration: Theme.quick; easing: ease-out; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: item.label; wrap: word-wrap; color: Theme.fg; }
                    if item.sub != "": Text { text: item.sub; wrap: word-wrap; font-size: 12.5px; color: Theme.muted; }
                }
                if item.text != "": Caps { text: item.text; color: Theme.accent; vertical-alignment: center; }
            }
            Rectangle {
                x: -4px;
                width: parent.width + 8px;
                border-radius: 6px;
                border-width: swf.has-focus ? 2px : 0px;
                border-color: Theme.accent;
            }
        }
        if item.kind == "choice": HorizontalLayout {
            spacing: 12px;
            opacity: item.enabled ? 1 : 0.5;
            Text { text: item.label; vertical-alignment: center; color: Theme.fg; horizontal-stretch: 1; wrap: word-wrap; }
            Choice {
                min-width: 220px;
                label: item.label;
                model: item.options;
                current: item.current;
                chosen(i) => { root.chosen(item.id, i); }
            }
        }
        if item.kind == "segments": VerticalLayout {
            spacing: 6px;
            if item.label != "": Caps { text: item.label.to-uppercase(); horizontal-alignment: centre ? center : left; }
            HorizontalLayout {
                alignment: centre ? center : start;
                Rectangle {
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.control-line;
                    clip: true;
                    width: segs.preferred-width;
                    opacity: item.enabled ? 1 : 0.5;
                    segs := HorizontalLayout {
                        for o[i] in item.options: Segment {
                            text: o;
                            on: i == item.current;
                            first: i == 0;
                            clicked => { if item.enabled { root.chosen(item.id, i); } }
                        }
                    }
                }
            }
        }
        if item.kind == "slider": HorizontalLayout {
            spacing: 12px;
            opacity: item.enabled ? 1 : 0.5;
            Text { text: item.label; vertical-alignment: center; color: Theme.fg; }
            Slide {
                horizontal-stretch: 1;
                y: (parent.height - self.height) / 2;
                label: item.label;
                enabled: item.enabled;
                minimum: item.min;
                maximum: item.max;
                value: item.value;
                released(v) => { root.slid(item.id, v); }
            }
            Text { text: item.text; vertical-alignment: center; font-family: Type.mono; color: Theme.soft; min-width: 44px; horizontal-alignment: right; }
        }
        if item.kind == "field": HorizontalLayout {
            spacing: 12px;
            if item.label != "": Text { text: item.label; vertical-alignment: center; color: Theme.fg; min-width: 120px; }
            Field {
                horizontal-stretch: 1;
                text: item.text;
                // Typing takes the text over from the row; after that the row's text still
                // reaches the field when the page clears it (a chat message sent) or sets it while
                // it isn't being typed in. Not while typing: the page's echo of a keystroke can lag
                // the next one.
                property <string> from-row: item.text;
                changed from-row => { if (!self.focused || self.from-row == "") { self.text = self.from-row; } }
                placeholder: item.placeholder;
                secret: item.secret;
                enabled: item.enabled;
                label: item.label;
                edited(t) => { root.edited(item.id, t); }
                accepted(t) => { root.accepted(item.id, t); }
            }
            for b in item.buttons: Btn {
                text: b.label;
                kind: b.kind;
                enabled: b.enabled;
                clicked => { root.pressed(b.id); }
            }
        }
        if item.kind == "area": VerticalLayout {
            spacing: 6px;
            if item.label != "": Text { text: item.label; color: Theme.fg; }
            Field {
                multiline: true;
                lines-height: max(96px, item.value * 1px);
                text: item.text;
                // As a one-line field's (above).
                property <string> from-row: item.text;
                changed from-row => { if (!self.focused || self.from-row == "") { self.text = self.from-row; } }
                placeholder: item.placeholder;
                enabled: item.enabled;
                label: item.label;
                edited(t) => { root.edited(item.id, t); }
            }
        }
        if item.kind == "buttons": HorizontalLayout {
            spacing: 10px;
            alignment: item.tone == "end" ? end : centre ? center : start;
            for b in item.buttons: Btn { text: b.label; kind: b.kind; enabled: b.enabled; clicked => { root.pressed(b.id); } }
        }
        if item.kind == "item": Rectangle {
            border-radius: 6px;
            background: ita.has-hover ? Theme.control : (item.on ? Theme.selected : transparent);
            ita := TouchArea {}
            HorizontalLayout {
                padding: 10px;
                padding-left: 12px;
                spacing: 12px;
                if item.tone != "": Rectangle {
                    width: 3px;
                    border-radius: 1.5px;
                    background: tone-colour;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text { text: item.label; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
                    if item.sub != "": Text { text: item.sub; font-size: 13px; color: Theme.soft; wrap: word-wrap; }
                    if item.text != "": Text { text: item.text; font-size: 13px; color: Theme.fg; wrap: word-wrap; }
                }
                for b in item.buttons: VerticalLayout {
                    alignment: center;
                    Btn { text: b.label; kind: b.kind; small: true; enabled: b.enabled; clicked => { root.pressed(b.id); } }
                }
            }
        }
        if item.kind == "result": HorizontalLayout {
            spacing: 10px;
            Dot { tone: item.tone; y: 7px; }
            VerticalLayout {
                horizontal-stretch: 1;
                Text { text: item.label; color: Theme.fg; wrap: word-wrap; }
                if item.sub != "": Text { text: item.sub; font-size: 12.5px; color: Theme.muted; wrap: word-wrap; }
            }
        }
        if item.kind == "message": HorizontalLayout {
            spacing: 10px;
            Text { text: item.label; font-weight: 600; color: item.on ? Theme.accent : Theme.fg; vertical-alignment: TextVerticalAlignment.top; }
            Text { text: item.text; color: item.tone == "" ? Theme.fg : tone-colour; wrap: word-wrap; horizontal-stretch: 1; }
            Text { text: item.sub; font-size: 11.5px; color: Theme.muted; font-family: Type.mono; }
            for b in item.buttons: Link { text: b.label; font-size: 12px; clicked => { root.pressed(b.id); } }
        }
        if item.kind == "working": HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Spinner { y: (parent.height - self.height) / 2; }
            Text { text: item.text; color: Theme.muted; }
        }
        if item.kind == "rule": Rule {}
        if item.kind == "mark": VerticalLayout {
            spacing: 12px;
            padding-top: 30px;
            padding-bottom: 10px;
            HorizontalLayout { alignment: center; EchelonMark { size: 56px; } }
            Text { text: item.label.to-uppercase(); horizontal-alignment: center; wrap: word-wrap; font-family: Type.cond; font-weight: 700; font-size: 24px; color: Theme.fg; }
            if item.text != "": Text { text: item.text; horizontal-alignment: center; wrap: word-wrap; color: Theme.soft; }
            // What to do about it.
            if item.buttons.length > 0: HorizontalLayout {
                alignment: center;
                spacing: 10px;
                padding-top: 6px;
                for b in item.buttons: Btn { text: b.label; kind: b.kind; enabled: b.enabled; min-height: 44px; clicked => { root.pressed(b.id); } }
            }
            if item.sub != "": Text { text: item.sub; horizontal-alignment: center; wrap: word-wrap; font-size: Type.small; color: Theme.muted; }
        }
        // A line and its buttons beside it ("Run a server elsewhere?" and Manage).
        if item.kind == "line": HorizontalLayout {
            spacing: 16px;
            Text { text: item.text; wrap: word-wrap; color: Theme.soft; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
            for b in item.buttons: VerticalLayout {
                alignment: center;
                Btn { text: b.label; kind: b.kind; small: true; enabled: b.enabled; clicked => { root.pressed(b.id); } }
            }
        }
        // A name and its value, side by side over a hairline (a summary of settings).
        if item.kind == "pair": VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 16px;
                Text { text: item.label; color: Theme.muted; font-size: 14px; vertical-alignment: center; }
                Text {
                    text: item.text;
                    color: Theme.fg;
                    font-size: 14px;
                    font-family: item.on ? Type.mono : Type.sans;
                    horizontal-alignment: right;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }
            Rule {}
        }
        // Tiles side by side: `current` of them, each three of `options` (a small heading, the
        // value and a line under it); `on`: the values are addresses (mono, smaller); `tone`
        // "warn" colours the last tile's value.
        if item.kind == "stats": HorizontalLayout {
            spacing: 14px;
            for i in item.current: Rectangle {
                // As wide as each other, whatever their text (the row's width shared out).
                width: (root.width - 2 * root.pad-x - (item.current - 1) * 14px) / max(1, item.current);
                min-height: tile.preferred-height;
                border-radius: 6px;
                border-width: 1px;
                border-color: carded ? Theme.control-line : Theme.line;
                background: carded ? transparent : Theme.surface;
                tile := VerticalLayout {
                    alignment: start;
                    padding: 14px;
                    padding-left: 16px;
                    spacing: 4px;
                    Caps { text: item.options[i * 3].to-uppercase(); overflow: elide; }
                    Text {
                        text: item.options[i * 3 + 1];
                        font-family: item.on ? Type.mono : Type.cond;
                        font-weight: item.on ? 400 : 700;
                        font-size: item.on ? 18px : 30px;
                        color: item.tone == "warn" && i == item.current - 1 ? Theme.warn : Theme.fg;
                        wrap: word-wrap;
                    }
                    if item.options[i * 3 + 2] != "": Text { text: item.options[i * 3 + 2]; font-size: Type.small; color: Theme.soft; wrap: word-wrap; }
                }
            }
        }
        // An empty list's place: a line and a smaller one under it, centred.
        if item.kind == "placeholder": VerticalLayout {
            padding-top: 48px;
            padding-bottom: 48px;
            spacing: 8px;
            Text { text: item.text; horizontal-alignment: center; wrap: word-wrap; color: Theme.soft; }
            if item.sub != "": Text { text: item.sub; horizontal-alignment: center; wrap: word-wrap; font-size: Type.small; color: Theme.muted; }
        }
        // Slint's own attribution (its royalty-free licence asks for it on the About screen).
        // With its text (About's small print): the text, and the widget beside it.
        if item.kind == "made-with-slint": HorizontalLayout {
            alignment: start;
            spacing: 20px;
            if item.text != "": Text {
                horizontal-stretch: 1;
                text: item.text;
                wrap: word-wrap;
                font-size: Type.small;
                color: Theme.muted;
                vertical-alignment: center;
            }
            AboutSlint {
                max-width: 360px;
                max-height: 120px;
            }
        }
        // A small label in capitals over what follows (About's sections).
        if item.kind == "caps": Caps {
            text: item.text.to-uppercase();
            color: item.tone == "accent" ? Theme.accent : Theme.muted;
        }
        // About's head: the mark large, the product, its release and whether it's current,
        // a line on what it is, and what to do.
        if item.kind == "about": Rectangle {
            min-height: about-lay.preferred-height;
            background: Theme.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.line;
            about-lay := HorizontalLayout {
                padding: Layout.compact ? 20px : 26px;
                spacing: Layout.compact ? 18px : 24px;
                VerticalLayout { alignment: center; EchelonMark { size: Layout.compact ? 60px : 96px; } }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    if item.sub != "": Caps { text: item.sub.to-uppercase(); color: Theme.accent; }
                    Text { text: item.label.to-uppercase(); wrap: word-wrap; font-family: Type.cond; font-weight: 700; font-size: Layout.compact ? 30px : 34px; color: Theme.fg; accessible-role: text; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        if item.placeholder != "": Rectangle {
                            border-width: 1px;
                            border-color: Theme.control-line;
                            border-radius: 4px;
                            width: version-text.preferred-width + 16px;
                            height: version-text.preferred-height + 4px;
                            version-text := Text { text: item.placeholder; font-family: Type.mono; font-size: 13px; color: Theme.fg; }
                        }
                        if item.options.length > 0: HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout { alignment: center; Dot { tone: item.tone; } }
                            Text { text: item.options[0]; font-size: Type.small; color: Theme.soft; vertical-alignment: center; }
                        }
                    }
                    if item.text != "": Text { text: item.text; wrap: word-wrap; color: Theme.soft; }
                    if item.buttons.length > 0: HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        padding-top: 6px;
                        for b in item.buttons: Btn { text: b.label; kind: b.kind; enabled: b.enabled; clicked => { root.pressed(b.id); } }
                    }
                }
            }
        }
        // A person: their initials (`id`) in a circle (the developer: their picture), name, a line and their links. `on`: the
        // developer, larger and ringed in the accent.
        if item.kind == "person": Rectangle {
            // Its height from the layout at the card's width, so wrapped lines aren't cut off.
            min-height: person-lay.preferred-height;
            person-lay := HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: item.value * 1px;
                        height: item.value * 1px;
                        border-radius: item.value * 0.5px;
                        background: item.on ? Theme.accent : Theme.control-line;
                        Rectangle {
                            x: item.on ? 2px : 1px;
                            y: self.x;
                            width: parent.width - 2 * self.x;
                            height: self.width;
                            border-radius: self.width / 2;
                            background: Theme.surface;
                            clip: true;
                            accessible-role: none;
                            if item.id == "jdevwebb": Image {
                                width: parent.width;
                                height: parent.height;
                                image-fit: cover;
                                source: @image-url("assets/avatars/jdevwebb.png");
                                accessible-role: image;
                                accessible-label: item.label + "'s picture";
                            }
                            if item.id != "jdevwebb": Text {
                                text: item.id;
                                font-size: parent.width * 0.38;
                                font-weight: 700;
                                color: item.on ? Theme.accent : Theme.fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 6px;
                    // The name, what they are beside it (`sub`), and a badge (`options[0]`).
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: item.label;
                            color: Theme.fg;
                            font-family: item.on || item.value >= 56 ? Type.cond : Type.sans;
                            font-weight: item.on || item.value >= 56 ? 700 : 600;
                            font-size: item.on ? 26px : item.value >= 56 ? 24px : 19px;
                            vertical-alignment: center;
                        }
                        if item.sub != "": Text { text: item.sub; font-size: 14px; color: Theme.muted; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        if item.options.length > 0: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: badge.preferred-height;
                                width: badge.preferred-width;
                                border-radius: self.height / 2;
                                background: Theme.selected;
                                border-width: 1px;
                                border-color: Theme.accent-soft;
                                badge := HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 3px;
                                    padding-bottom: 3px;
                                    spacing: 6px;
                                    VerticalLayout { alignment: center; Dot { size: 6px; } }
                                    Text { text: item.options[0]; font-size: 12px; color: Theme.accent; vertical-alignment: center; }
                                }
                            }
                        }
                        if item.sub == "": Rectangle { horizontal-stretch: 1; }
                    }
                    if item.text != "": Text { text: item.text; wrap: word-wrap; font-size: 15px; color: Theme.soft; }
                    if item.buttons.length > 0 || item.placeholder != "": HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        for b in item.buttons: Btn { text: b.label; kind: b.kind; small: true; enabled: b.enabled; clicked => { root.pressed(b.id); } }
                        if item.placeholder != "": Text { text: item.placeholder; font-size: 13px; color: Theme.muted; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                }
        
            }
        }
        // Supporting the community servers: free always, hosting only, optional.
        if item.kind == "support": Rectangle {
            min-height: support-card.preferred-height;
            background: Theme.selected;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.accent-soft;
            support-card := VerticalLayout {
                padding: 22px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    VerticalLayout { alignment: center; Cup { size: 22px; } }
                    Text { text: item.label; font-family: Type.cond; font-weight: 700; font-size: 22px; color: Theme.fg; vertical-alignment: center; }
                }
                Text { text: item.text; wrap: word-wrap; font-size: 14px; color: Theme.soft; }
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    padding-top: 4px;
                    for b in item.buttons: Btn { text: b.label; kind: b.kind; enabled: b.enabled; clicked => { root.pressed(b.id); } }
                    if item.placeholder != "": Text { text: item.placeholder; font-family: Type.mono; font-size: 12.5px; color: Theme.muted; vertical-alignment: center; }
                }
                if item.sub != "": Text { text: item.sub; wrap: word-wrap; font-size: 12.5px; color: Theme.muted; }
            }
        }
        // The same, as a strip (the What's new window): the line and its button side by side.
        if item.kind == "support-strip": Rectangle {
            min-height: support-strip.preferred-height;
            background: Theme.selected;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.accent-soft;
            support-strip := HorizontalLayout {
                padding: 14px;
                padding-left: 16px;
                spacing: 14px;
                VerticalLayout { alignment: center; Cup { size: 26px; } }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text { text: item.label; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
                    Text { text: item.text; wrap: word-wrap; font-size: 13.5px; color: Theme.soft; }
                    if item.sub != "": Text { text: item.sub; wrap: word-wrap; font-size: 12.5px; color: Theme.muted; }
                }
                for b in item.buttons: VerticalLayout {
                    alignment: center;
                    Btn { text: b.label; kind: b.kind; enabled: b.enabled; clicked => { root.pressed(b.id); } }
                }
            }
        }
        if item.kind == "space": Rectangle { height: 14px; }
    }
}

// A column of rows (one of a list's columns).
component RowColumn inherits VerticalLayout {
    in property <[Row]> rows;
    in property <bool> centre-text;
    callback toggled(string, bool);
    callback chosen(string, int);
    callback slid(string, float);
    callback edited(string, string);
    callback accepted(string, string);
    callback pressed(string);
    alignment: start;
    for r in root.rows: RowItem {
        item: r;
        centre-text: root.centre-text;
        toggled(a, b) => { root.toggled(a, b); }
        chosen(a, b) => { root.chosen(a, b); }
        slid(a, b) => { root.slid(a, b); }
        edited(a, b) => { root.edited(a, b); }
        accepted(a, b) => { root.accepted(a, b); }
        pressed(a) => { root.pressed(a); }
    }
}

// A list of rows, scrolled: a column that grows to `measure`, at `pad` from the left or centred,
// with a second column beside it when there's one (`side`: `split` the first's share), and
// anything put inside it (the guided setup's head) above the rows.
export component RowList inherits Rectangle {
    in property <[Row]> rows;
    in property <[Row]> side;
    in property <float> split: 0.6;
    in property <length> gap: 24px;
    in property <length> measure: 820px;
    in property <length> pad: 40px;
    in property <bool> centred: false;
    // Shorter than the space: in the middle of it, top to bottom too (the guided setup), the
    // text outside cards centred.
    in property <bool> middle: false;
    // The rows' own height, for a dialog that's no taller than it needs.
    out property <length> content-height: inner.preferred-height + 36px;
    // Where the column is, for a title over it.
    out property <length> column-width: min(root.measure, sv.visible-width - 2 * root.pad);
    out property <length> column-x: root.centred ? max(root.pad, (sv.visible-width - self.column-width) / 2) : root.pad;
    property <bool> two: root.side.length > 0;
    // Another page (its title): back to the top.
    in property <string> page;
    changed page => { sv.viewport-y = 0; }
    callback toggled(string, bool);
    callback chosen(string, int);
    callback slid(string, float);
    callback edited(string, string);
    callback accepted(string, string);
    callback pressed(string);
    sv := ScrollView {
        content-width: self.visible-width;
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: sv.visible-width;
            padding-left: root.column-x;
            padding-right: sv.visible-width - root.column-x - root.column-width;
            padding-top: root.middle ? max(4px, (sv.visible-height - inner.preferred-height - 32px) / 2) : 4px;
            padding-bottom: 32px;
            inner := VerticalLayout {
                @children
                HorizontalLayout {
                    spacing: root.two ? root.gap : 0px;
                    alignment: start;
                    RowColumn {
                        width: root.two ? (root.column-width - root.gap) * root.split : root.column-width;
                        rows: root.rows;
                        centre-text: root.middle;
                        toggled(a, b) => { root.toggled(a, b); }
                        chosen(a, b) => { root.chosen(a, b); }
                        slid(a, b) => { root.slid(a, b); }
                        edited(a, b) => { root.edited(a, b); }
                        accepted(a, b) => { root.accepted(a, b); }
                        pressed(a) => { root.pressed(a); }
                    }
                    if root.two: RowColumn {
                        width: (root.column-width - root.gap) * (1 - root.split);
                        rows: root.side;
                        toggled(a, b) => { root.toggled(a, b); }
                        chosen(a, b) => { root.chosen(a, b); }
                        slid(a, b) => { root.slid(a, b); }
                        edited(a, b) => { root.edited(a, b); }
                        accepted(a, b) => { root.accepted(a, b); }
                        pressed(a) => { root.pressed(a); }
                    }
                }
            }
        }
    }
}

// A status beside a page's title: a dot and a line in a pill ("Running · 2 h 14 min").
component StatusPill inherits Rectangle {
    in property <string> text;
    // "ok", "warn", "bad" or "" (muted).
    in property <string> tone;
    height: pill.preferred-height;
    width: pill.preferred-width;
    border-radius: self.height / 2;
    background: tone == "ok" ? Theme.selected : transparent;
    border-width: 1px;
    border-color: tone == "ok" ? Theme.accent-soft : tone == "warn" ? Theme.warn : tone == "bad" ? Theme.bad : Theme.control-line;
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    pill := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 8px;
        VerticalLayout { alignment: center; Dot { tone: root.tone == "bad" ? "fail" : root.tone == "" ? "muted" : root.tone; } }
        Text {
            text: root.text;
            font-size: 14px;
            vertical-alignment: center;
            color: tone == "ok" ? Theme.accent : tone == "warn" ? Theme.warn : tone == "bad" ? Theme.bad : Theme.soft;
        }
    }
}

// A page of rows: its kicker and title, an optional menu of sections down the side, and its
// rows in a column that grows with the window to Layout.column (Layout.columns with two) and
// then sits centred, the title over it; or, for the guided setup, a dialog's width centred both
// ways.
export component Page inherits Rectangle {
    in property <string> kicker;
    in property <string> title;
    in property <string> summary;
    in property <[string]> sections;
    in property <[string]> section-ids;
    in property <string> section;
    in property <[Row]> rows;
    in property <[Row]> side;
    in property <float> split: 0.6;
    in property <string> layout;
    in property <string> status;
    in property <string> status-tone;
    in property <[RowButton]> actions;
    callback go-section(string);
    callback toggled(string, bool);
    callback chosen(string, int);
    callback slid(string, float);
    callback edited(string, string);
    callback accepted(string, string);
    callback pressed(string);
    property <bool> setup: root.layout == "setup";
    property <bool> has-sections: root.sections.length > 0;
    background: Theme.bg;
    HorizontalLayout {
        if has-sections: Rectangle {
            width: Layout.compact ? 200px : 220px;
            background: Theme.rail;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
            VerticalLayout {
                padding: 24px;
                padding-right: 16px;
                spacing: 2px;
                alignment: start;
                Caps { text: root.kicker.to-uppercase(); color: Theme.accent; }
                Text { text: root.title.to-uppercase(); font-family: Type.cond; font-weight: 700; font-size: Layout.compact ? 30px : 34px; color: Theme.fg; }
                Rectangle { height: 12px; }
                for s[i] in sections: Rectangle {
                    height: 36px;
                    border-radius: 4px;
                    background: root.section-ids[i] == root.section ? Theme.selected : nta.has-hover ? Theme.control : transparent;
                    accessible-role: tab;
                    accessible-label: s;
                    accessible-checked: root.section-ids[i] == root.section;
                    accessible-action-default => { root.go-section(root.section-ids[i]); }
                    forward-focus: nfs;
                    nfs := FocusScope {
                        key-pressed(e) => {
                            if e.text == Key.Return || e.text == " " { root.go-section(root.section-ids[i]); return accept; }
                            reject
                        }
                    }
                    nta := TouchArea { mouse-cursor: pointer; clicked => { root.go-section(root.section-ids[i]); } }
                    if root.section-ids[i] == root.section: Rectangle { x: 0; width: 2px; height: parent.height - 12px; background: Theme.accent; }
                    Text {
                        x: 12px;
                        width: parent.width - 16px;
                        text: s;
                        vertical-alignment: center;
                        overflow: elide;
                        color: root.section-ids[i] == root.section ? Theme.accent : Theme.soft;
                        font-weight: root.section-ids[i] == root.section ? 600 : 400;
                    }
                    Rectangle { border-radius: 4px; border-width: nfs.has-focus ? 2px : 0px; border-color: Theme.accent; }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            // The title over the column (the guided setup's is in it, centred).
            // (Placed by hand in a plain rectangle: the column's place comes from the list's
            // width, which a layout's padding would feed back into.)
            if !setup: Rectangle {
              height: head.preferred-height;
              head := HorizontalLayout {
                x: list.column-x;
                width: list.column-width;
                padding-top: Layout.compact ? 20px : 28px;
                padding-bottom: 12px;
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: end;
                    if !has-sections: Caps { text: root.kicker.to-uppercase(); color: Theme.accent; }
                    Text {
                        text: (has-sections ? root.summary : root.title).to-uppercase();
                        font-family: Type.cond;
                        font-weight: 700;
                        font-size: has-sections ? (Layout.compact ? 26px : 30px) : Layout.title-size;
                        color: Theme.fg;
                        wrap: word-wrap;
                    }
                    if !has-sections && root.summary != "": Text { text: root.summary; color: Theme.soft; font-size: Type.small; wrap: word-wrap; }
                }
                if root.status != "": VerticalLayout {
                    alignment: end;
                    padding-bottom: root.actions.length > 0 ? 6px : 2px;
                    StatusPill { text: root.status; tone: root.status-tone; }
                }
                for b in root.actions: VerticalLayout {
                    alignment: end;
                    Btn { text: b.label; kind: b.kind; enabled: b.enabled; big: true; clicked => { root.pressed(b.id); } }
                }
              }
            }
            list := RowList {
                vertical-stretch: 1;
                page: root.title + "/" + root.section;
                rows: root.rows;
                side: root.side;
                split: root.split;
                gap: Layout.gap;
                centred: true;
                middle: setup;
                pad: Layout.gutter;
                measure: setup || root.layout == "narrow" ? Layout.narrow : (root.side.length > 0 || root.layout == "wide") ? Layout.columns : Layout.column;
                toggled(a, b) => { root.toggled(a, b); }
                chosen(a, b) => { root.chosen(a, b); }
                slid(a, b) => { root.slid(a, b); }
                edited(a, b) => { root.edited(a, b); }
                accepted(a, b) => { root.accepted(a, b); }
                pressed(a) => { root.pressed(a); }
                // The guided setup's head: what it is, the mark, its title and the line under.
                if setup: VerticalLayout {
                    spacing: 14px;
                    padding-bottom: 18px;
                    Caps { text: root.kicker.to-uppercase(); color: Theme.accent; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            border-radius: 12px;
                            background: Theme.control;
                            border-width: 1px;
                            border-color: Theme.control-line;
                            EchelonMark { size: 34px; tile: false; }
                        }
                    }
                    Text {
                        text: root.title.to-uppercase();
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        font-family: Type.cond;
                        font-weight: 700;
                        font-size: Layout.compact ? 34px : 40px;
                        color: Theme.fg;
                    }
                    if root.summary != "": HorizontalLayout {
                        alignment: center;
                        Text {
                            max-width: 620px;
                            text: root.summary;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            font-size: 16px;
                            color: Theme.soft;
                        }
                    }
                }
            }
        }
    }
}

// A dialog of rows over the window: its kicker and title, the rows, a scrim behind that it
// keeps the clicks from.
export component Dialog inherits Rectangle {
    in property <string> kicker;
    in property <string> title;
    in property <[Row]> rows;
    in property <length> dialog-width: 520px;
    callback toggled(string, bool);
    callback chosen(string, int);
    callback slid(string, float);
    callback edited(string, string);
    callback accepted(string, string);
    callback pressed(string);
    background: Theme.scrim;
    TouchArea {}
    // Esc puts it away (where there's a way out: ui.rs decides); keys from its fields come
    // here too.
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape { root.pressed("escape"); return accept; }
            reject
        }
        Rectangle {
            width: min(root.dialog-width, root.width - 48px);
            height: min(box.preferred-height, root.height - 48px);
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.control-line;
            drop-shadow-blur: 50px;
            drop-shadow-color: #00000099;
            accessible-role: groupbox;
            accessible-label: root.title;
            box := VerticalLayout {
                padding-top: 22px;
                VerticalLayout {
                    padding-left: 26px;
                    padding-right: 26px;
                    if root.kicker != "": Caps { text: root.kicker.to-uppercase(); color: Theme.accent; }
                    Text { text: root.title.to-uppercase(); font-family: Type.cond; font-weight: 700; font-size: 24px; color: Theme.fg; wrap: word-wrap; }
                }
                RowList {
                    height: min(self.content-height, root.height - 190px);
                    pad: 26px;
                    measure: 2000px;
                    rows: root.rows;
                    toggled(a, b) => { root.toggled(a, b); }
                    chosen(a, b) => { root.chosen(a, b); }
                    slid(a, b) => { root.slid(a, b); }
                    edited(a, b) => { root.edited(a, b); }
                    accepted(a, b) => { root.accepted(a, b); }
                    pressed(a) => { root.pressed(a); }
                }
            }
        }

    }
}

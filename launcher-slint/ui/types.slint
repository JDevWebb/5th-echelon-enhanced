// What the Rust side hands the screens (ui.rs fills these from core.rs). Numbers that may be
// unknown are -1 then (a ping that didn't answer, a match's seats on an old server).

export struct InfoView {
    game-dir: string,
    server: string,
    account: string,
    identity: string,
    community: bool,
    // "play", "svm" or "coop".
    play-mode: string,
    managed: bool,
    running: bool,
    connecting: bool,
    beta: int,
    name-not-allowed: string,
    emulator-notice: bool,
    new-match: bool,
    requests: int,
}

// The Play button: what it says, its second line, its tone ("ok", "warn", "fail", "checking",
// "muted"), and what pressing it does (ui.rs).
export struct PlayButton {
    label: string,
    sub: string,
    tone: string,
    disabled: bool,
    busy: bool,
    // Why Play can't start now, for screen readers.
    why: string,
    // "status": pressing it shows the Status tab (the checks to fix); anything else is ui.rs's.
    action: string,
}

export struct ServerCard {
    shown: bool,
    caption: string,
    caption-why: string,
    place: string,
    ping: int,
    // The ping and players are known (a listed server).
    listed: bool,
    players: int,
}

export struct ServerRow {
    host: string,
    place: string,
    name: string,
    ping: int,
    players: int,
    playing: string,
    current: bool,
    best: bool,
    maintenance: string,
}

export struct CheckRow {
    id: string,
    // "ok", "warn" or "fail".
    status: string,
    title: string,
    detail: string,
    fix-id: string,
    fix-label: string,
}

export struct FriendRow {
    id: string,
    name: string,
    activity: string,
    joinable: bool,
    with-me: bool,
}

export struct OtherRow {
    id: string,
    name: string,
    activity: string,
    asked: bool,
    asked-us: bool,
}

export struct ElsewhereRow {
    name: string,
    place: string,
    host: string,
    public: bool,
}

// A mode to find or host a match in: a Spies vs Mercs playlist, or Co-op.
export struct ModeItem {
    playlist: int,
    name: string,
    coop: bool,
}

export struct NoticeRow {
    place: string,
    mine: bool,
    version: string,
    doing: string,
    // 0 to 1, or below 0 for none.
    meter: float,
    // "waiting", "now" or "done".
    tone: string,
}

export struct NoticeView {
    shown: bool,
    heading: string,
    eta: string,
    text: string,
    note: string,
    play-on-host: string,
    play-on-label: string,
    servers: [NoticeRow],
}

export struct PersonRow {
    name: string,
    // Their first letter, for the avatar.
    initial: string,
    host: bool,
    party: int,
    party-line: string,
    friend: bool,
    // "spy", "merc" or "".
    team: string,
    ping: int,
    me: bool,
}

export struct SettingRow {
    key: string,
    value: string,
}

export struct LobbyRow {
    room: int,
    mode: string,
    // "svm" or "coop".
    kind: string,
    map: string,
    players: int,
    seats: int,
    made-for: int,
    host: string,
    status: string,
    // "ok" (joinable) or "warn" (under way, or full).
    tone: string,
    under-way: bool,
    full: bool,
    joinable: bool,
    open-for: string,
    ping: int,
    // "Hosted by Kai, your friend · Sam, your friend, is in it".
    line: string,
    has-friends: bool,
    teams: bool,
    people: [PersonRow],
    spies: [PersonRow],
    mercs: [PersonRow],
    with-me: bool,
    settings: [SettingRow],
    // How many wait to join it (the server's queue), and this player's place (1 = next; 0: not
    // in line).
    waiting: int,
    queue-place: int,
    // The game's own picture for it (the map's, else the mode's), when the game has one.
    art: image,
}

// Chat ("Comms"; pages/chat.rs builds these): the conversations across the top, the log, the
// roster beside Global, and the rest of the screen.
export struct ChatTab {
    // The section's id: "global", "lobby" or "with:<identity>".
    id: string,
    label: string,
    direct: bool,
    initial: string,
    // Beside the label: "24 on" (Global), or nothing.
    count: string,
    unread: int,
    // A friend online here (the tile's green edge), or offline (dimmed).
    online: bool,
    offline: bool,
}

export struct ChatLine {
    // "msg", "day" (a day's line) or "new" (where the unseen messages start).
    kind: string,
    // The message's id, for what's done to it.
    key: string,
    time: string,
    // The sender's name ("You" for the player's own), their first letter, their identity.
    who: string,
    initial: string,
    from: string,
    // "friend", "me" or "": the tile's edge.
    tone: string,
    friend: bool,
    mine: bool,
    mention: bool,
    // The first of a sender's lines together: the tile and the name show.
    head: bool,
    text: string,
    // A Discord invite in it, shown as a card.
    invite: string,
    // Picked (its actions show), its report being written.
    picked: bool,
    reporting: bool,
    can-message: bool,
    can-add: bool,
}

export struct RosterRow {
    // "head" (a group's caption), "person", or "more" ("and 4 more").
    kind: string,
    id: string,
    name: string,
    line: string,
    // "friend", "match" or "menu": the left edge.
    tone: string,
    join: bool,
    asked: bool,
    picked: bool,
}

export struct ChatNote {
    text: string,
    // "warn", "bad" or "": the left edge.
    tone: string,
    // Over the log (the connection), or by the line to write (what's typed, Global's wait).
    top: bool,
}

// One of "+ Message a friend"'s choices: a friend, or a conversation not across the top.
export struct ChatPick {
    id: string,
    label: string,
    initial: string,
    line: string,
    unread: int,
    online: bool,
}

export struct ChatView {
    // "open", "no-account", "opening", or anything else (`why` says).
    state: string,
    why: string,
    // The conversation shown: its section's id ("global", "lobby", "with:<identity>").
    tab: string,
    // The connection: its line and its dot's tone ("ok", "warn", "fail").
    conn: string,
    conn-tone: string,
    // The line to write: its label ("TX // GLOBAL"), placeholder, whether it can be typed in
    // and sent, and a count that goes up with each message sent (the field empties then).
    tx: string,
    placeholder: string,
    can-type: bool,
    can-send: bool,
    sent: int,
    rules: string,
    // Under the conversations: the room's line (Lobby's); an empty room's line.
    room-line: string,
    empty: string,
    // A direct message's friend: their name, ID, where they are, and Join (their account id).
    strip: bool,
    strip-name: string,
    strip-id: string,
    strip-line: string,
    strip-online: bool,
    strip-join: string,
    // The roster (Global only): how many are in it.
    roster: bool,
    roster-count: int,
    // The player picked in the roster or the log: their dossier, and what can be done (each an
    // action's id for `pressed`, or "" when it can't).
    dossier: bool,
    dossier-name: string,
    dossier-initial: string,
    dossier-id: string,
    dossier-line: string,
    dossier-friend: bool,
    dossier-add: string,
    dossier-asked: bool,
    dossier-message: string,
    dossier-invite: string,
    dossier-report: string,
    dossier-block: string,
    // A Discord invite to confirm before it opens.
    invite: string,
    // The report being written: whose message, and why.
    report-who: string,
    report-why: string,
    // The button opening the friends to message ("+ Message a friend", shorter when narrow).
    more-label: string,
}

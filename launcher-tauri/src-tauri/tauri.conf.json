{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "5th Echelon Enhanced",
  "version": "0.0.0",
  "identifier": "net.jdevwebb.fifth-echelon.launcher",
  "build": { "frontendDist": "../ui/dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "5th Echelon Enhanced",
        "width": 1280,
        "height": 800,
        "minWidth": 896,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
